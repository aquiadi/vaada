# Production: live Razorpay Route (rzp_live_ keys only), Polygon mainnet, Resend. Each value is checked at boot.
VAADA_ENV=production
# The direct connection or the session pooler (port 5432); the transaction pooler (6543) is refused.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
REDIS_URL=<railway redis url>
WEB_ORIGIN=https://<your-domain>
API_PUBLIC_URL=https://api.<your-domain>
TRUST_PROXY_HEADERS=true

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
GOOGLE_SIGNIN_ENABLED=false

PAYMENTS_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_live_<...>
RAZORPAY_KEY_SECRET=<live key secret>
RAZORPAY_WEBHOOK_SECRET=<the secret you set on the live webhook>

# Fees in basis points. CLIENT_FEE_BPS must cover GATEWAY_FEE_BPS on the grossed-up order; the API checks this at boot.
CLIENT_FEE_BPS=242
GATEWAY_FEE_BPS=236
ROUTE_TRANSFER_FEE_BPS=0
PLATFORM_FEE_BPS=0
TDS_BPS=0

REF_HMAC_SECRET=<openssl rand -hex 32>

CHAIN_RPC_URL=<Polygon RPC URL>
CHAIN_ID=137
REGISTRY_ADDRESS=<from contracts/deployments/137.json>
RECORDER_PRIVATE_KEY=<recorder key, funded with a little POL>
CHAIN_EXPLORER_TX_URL=https://polygonscan.com/tx/

EMAIL_TRANSPORT=resend
RESEND_API_KEY=<live key>
EMAIL_FROM=Vaada <deeds@<your-domain>>
ADMIN_EMAILS=<your email>
SENTRY_DSN=<optional>
