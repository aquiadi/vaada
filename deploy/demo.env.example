# The public demo: personas, FakeGateway, no Razorpay keys at all (the API refuses to start with any).
# Copy these into the Railway API and worker services. Values in <angle brackets> are yours to fill.
VAADA_ENV=demo
# Supabase's session pooler (port 5432). The transaction pooler (6543) is refused at boot; the direct host is IPv6-only.
DATABASE_URL=postgresql://postgres.<demo-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
REDIS_URL=${{Redis.REDIS_URL}}
WEB_ORIGIN=https://<demo-web>.up.railway.app
API_PUBLIC_URL=https://<demo-api>.up.railway.app
TRUST_PROXY_HEADERS=true

SUPABASE_URL=https://<demo-project-ref>.supabase.co
SUPABASE_ANON_KEY=<demo anon key>

PERSONA_SWITCHER_ENABLED=true
PERSONA_TOKEN_SECRET=<openssl rand -hex 32>
DEV_TOOLS_ENABLED=true
PAYMENTS_GATEWAY=fake
FAKE_GATEWAY_KEY_SECRET=<openssl rand -hex 32>
FAKE_GATEWAY_WEBHOOK_SECRET=<openssl rand -hex 32>

REF_HMAC_SECRET=<openssl rand -hex 32>

# Optional: record demo deeds on Polygon Amoy. Leave all three empty to skip the registry.
CHAIN_RPC_URL=
CHAIN_ID=80002
REGISTRY_ADDRESS=
RECORDER_PRIVATE_KEY=
CHAIN_EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/

EMAIL_TRANSPORT=outbox
ADMIN_EMAILS=
SENTRY_DSN=
