# Staging: real Razorpay test mode (rzp_test_ keys only), Polygon Amoy, real sign-in. No personas, no FakeGateway.
VAADA_ENV=staging
DATABASE_URL=postgresql://postgres:<password>@db.<staging-project-ref>.supabase.co:5432/postgres
REDIS_URL=<railway redis url>
WEB_ORIGIN=https://<staging-web>.vercel.app
API_PUBLIC_URL=https://<staging-api>.up.railway.app
TRUST_PROXY_HEADERS=true

SUPABASE_URL=https://<staging-project-ref>.supabase.co
SUPABASE_ANON_KEY=<staging anon key>
GOOGLE_SIGNIN_ENABLED=false

PAYMENTS_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_test_<...>
RAZORPAY_KEY_SECRET=<test key secret>
RAZORPAY_WEBHOOK_SECRET=<the secret you set on the staging webhook>

REF_HMAC_SECRET=<openssl rand -hex 32>

CHAIN_RPC_URL=<Amoy RPC URL>
CHAIN_ID=80002
REGISTRY_ADDRESS=<from contracts/deployments/80002.json>
RECORDER_PRIVATE_KEY=<recorder key, funded with Amoy POL>
CHAIN_EXPLORER_TX_URL=https://amoy.polygonscan.com/tx/

EMAIL_TRANSPORT=resend
RESEND_API_KEY=<staging key>
EMAIL_FROM=Vaada Staging <deeds@<your-domain>>
ADMIN_EMAILS=<your email>
SENTRY_DSN=
